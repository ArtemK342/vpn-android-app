<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+: no cloud backup and no device-to-device transfer of app data.
   SharedPreferences hold auth tokens and cached WireGuard configs (private keys),
   which must not leave the device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
