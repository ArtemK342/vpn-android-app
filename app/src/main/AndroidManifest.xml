<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Разрешение на интернет -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Разрешение для VPN -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Разрешение для уведомлений (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Работа в фоновом режиме без ограничений батареи -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Установка APK обновлений -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- «Запуск при включении телефона» (VpnOptions.BootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Правила → Приложения: видим только приложения с иконкой на рабочем столе (без QUERY_ALL_PACKAGES) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FsocietyApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vpnapp">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Vpnapp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name="org.amnezia.awg.backend.AbstractBackend$VpnService"
            android:process=":awg"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Kill Switch: блокирующий VPN-интерфейс при обрыве туннеля (KillSwitch.kt) -->
        <service
            android:name=".KillSwitchService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN kill switch" />
        </service>
        <receiver
            android:name=".KillSwitchReleaseReceiver"
            android:exported="false" />
        <!-- AmneziaWG — в своём процессе: в одном процессе с sing-box два Go-рантайма роняли приложение -->
        <service
            android:name=".AwgService"
            android:process=":awg"
            android:exported="false" />
        <!-- «Постоянная VPN» из процесса «:awg» → подключение в основном процессе -->
        <receiver
            android:name=".AlwaysOnReceiver"
            android:exported="false" />
        <!-- «Запуск при включении телефона» -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Результат ночной тихой установки обновления (AutoUpdate.kt) -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
        <receiver
            android:name=".VpnDisconnectReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ru.fsociety.vpn.DISCONNECT" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".VpnConnectReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="ru.fsociety.vpn.CONNECT" />
            </intent-filter>
        </receiver>
        <service
            android:name=".VpnForegroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN status notification" />
        </service>
        <service
            android:name=".XrayVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <service
            android:name=".OpenVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>

</manifest>